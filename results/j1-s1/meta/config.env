# =============================================================================
# config.env : TOUS les paramètres du projet.
# Les valeurs ci-dessous sont des valeurs PAR DÉFAUT (entraînement). Les valeurs
# définitives viendront de la phase 2 : on ne modifie QUE ce fichier, jamais les scripts.
# Ce fichier est lu (« sourcé ») par tous les scripts, sur la machine cible comme
# sur la machine de charge : il doit donc être identique des deux côtés (Git).
# =============================================================================

# ---- 1. Profils de ressources (identiques pour la VM et le conteneur) --------
PROFILE=A                 # profil par défaut
PROFILE_A_VCPUS=2         # profil A : scénarios 1, 3, 4, 5
PROFILE_A_RAM_MB=2048
PROFILE_B_VCPUS=1         # profil B : scénarios 2 et 6 (nombreuses instances)
PROFILE_B_RAM_MB=1024
S1_PROFILE=A
S2_PROFILE=B
S3_PROFILE=A
S4_PROFILE=A
S5_PROFILE=A
S6_PROFILE=B
CPU_PIN=none              # none | spread : épingler chaque instance sur des cœurs distincts

# ---- 2. Machine cible, vue depuis la machine de charge ------------------------
TARGET_HOST=192.168.137.216               # adresse IP de la cible sur le réseau de mesure
TARGET_USER=njioua                       # compte SSH sur la cible
TARGET_SSH_KEY="$HOME/.ssh/id_ed25519"  # clé privée de la machine de charge
TARGET_PROJECT_DIR=projet-vm-conteneurs # chemin du projet sur la cible, relatif à son dossier personnel

# ---- 3. Machines virtuelles (KVM/QEMU via libvirt) ----------------------------
VM_PREFIX=bench-vm
VM_USER=ubuntu
VM_SSH_KEY_FILE=id_ed25519_bench        # créée dans work/ sur la cible
DISK_GB=10                              # taille du disque (minimum 10)
DISK_FORMAT=qcow2                       # qcow2 | raw
DISK_BUS=virtio
DISK_CACHE=none                         # none | writeback | writethrough | directsync | unsafe
CPU_MODE=host-passthrough
VM_NET_SPEC="network=default,model=virtio"   # NAT libvirt ; pont : "bridge=br0,model=virtio"
VM_FORWARD_PORTS=1                      # 1 : NAT + redirection de ports (iptables) ; 0 : pont, IP directe
LIBVIRT_URI=qemu:///system
OS_VARIANT=ubuntu24.04                  # si "unknown OS" : ubuntu22.04 ou generic
IMAGES_DIR=/var/lib/libvirt/images
IMAGE_URL_BASE=https://cloud-images.ubuntu.com/releases/24.04/release
IMAGE_FILE=ubuntu-24.04-server-cloudimg-amd64.img
IMAGE_SHA256=                           # vide : récupérée dans SHA256SUMS ; la renseigner pour figer l'image
VM_HTTP_PORT_BASE=9300                  # VM n -> port 9300+n sur la cible (HTTP)
VM_IPERF_PORT_BASE=9400                 # VM n -> port 9400+n sur la cible (iperf3)
VM_DATA_DIR=/var/tmp/fio                # dossier des tests disque dans la VM

# ---- 4. Conteneurs (Docker) ---------------------------------------------------
CTR_PREFIX=bench-ctr
CTR_IMAGE=bench-app:1.0
CTR_NETWORK_MODE=bridge                 # bridge | host (host : une seule instance, ports 80 et 5201)
CTR_DATA_MODE=layer                     # layer (couche overlay2) | volume (volume Docker) : à décider en phase 2
CTR_HTTP_PORT_BASE=8300
CTR_IPERF_PORT_BASE=8400

# ---- 5. Protocole d'expérience -----------------------------------------------
REPEATS=10                # répétitions retenues (le CDC demande au moins 10)
WARMUP=2                  # essais d'échauffement (enregistrés mais écartés de l'analyse)
PAUSE_S=5                 # pause entre deux essais (retour à une température comparable)
DROP_CACHES=1             # 1 : vider les caches de la cible avant chaque essai
READY_TIMEOUT_S=600       # délai maximal d'attente d'une instance
HOST_GOVERNOR=performance # gouverneur de fréquence de la cible (target/prepare-host.sh apply)
HOST_NO_TURBO=keep        # keep (ne pas toucher) | 1 (désactiver le turbo) | 0 (l'activer)
WORKDIR=work              # fichiers générés (sur chaque machine)
RESULTS_DIR=results       # résultats (sur la machine de charge)

# ---- 6. Paramètres des scénarios ---------------------------------------------
# S2 : CPU et mémoire
INSTANCE_LEVELS="1 2 4 8"
IDLE_SAMPLE_S=15
STRESS_TIMEOUT=30
STRESS_VM_BYTES=256M      # valeur absolue : un pourcentage serait calculé sur la RAM de l'hôte
# S3 : réseau
IPERF_TIME=20
WRK_THREADS=2
WRK_DURATION=15
S3_WRK_CONNS="16 64 256"
S3_LAT_RATE=200           # débit (req/s) de la mesure de latence à faible charge
# S4 : disque (format  nom:motif:taille_bloc:profondeur:nb_tâches:sens)
FIO_SIZE=1G
FIO_RUNTIME=30
FIO_RAMP=5
FIO_JOBS="seqread:read:1M:16:1:read seqwrite:write:1M:16:1:write randread:randread:4k:32:1:read randwrite:randwrite:4k:32:1:write randread4j:randread:4k:32:4:read"
S4_LEVELS="1 4"           # nombre d'instances sollicitées simultanément
# S5 : application
S5_RATES="500 2000 5000"  # charges faible, moyenne, élevée (req/s, wrk2)
S5_CONNS=64
S5_DURATION=30
S5_SAT_CONNS=128          # charge saturante (wrk sans débit imposé)
S5_AB_REQUESTS=50000
S5_AB_CONC=64
# S6 : densité
S6_LEVELS="1 2 4 6 8 10 12 16 20 24"
S6_MEM_LIMIT_PCT=90       # limite de mémoire de l'hôte fixée à l'avance
S6_HOST_RESERVE_MB=1024   # mémoire laissée à l'hôte
S6_RATE=500               # charge sonde sur l'instance 1
S6_DURATION=20
S6_P99_FACTOR=3           # point de rupture : p99 > facteur x p99 du premier palier, ou erreurs
